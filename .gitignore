# Generated by Cargo
# will have compiled files and executables
/target
.DS_Store

# These are backup files generated by rustfmt
**/*.rs.bk
node_modules/
assets/data/
assets/uploads/
public/uploads/
public/data/
.env

# Local AI agent / tooling state — never commit
.claude/
.playwright-mcp/

# crates/app/assets/ is a build-time mirror of root assets/ (populated by build.rs)
# Only root assets/ is the source of truth — do not track the copy.
crates/app/assets/
# tailwind.css is compiled output (not hand-edited); tracked in root assets/ only
# Source: crates/app/tailwind-input.css → compile → crates/app/assets/tailwind.css → sync → assets/tailwind.css
search-index
# 由 scripts/tw-sources.mjs 在构建时生成（含本机 cargo registry 绝对路径，dioxus-ui FB-01）
crates/app/tailwind-sources.css

# 本地运行时数据（tantivy 搜索索引等，对应 SEARCH_INDEX_DIR）——不入库
/data/

# 站点文章是各自部署的内容，不进框架仓库；只保留示例文章与作者表
/assets/posts/*
!/assets/posts/welcome/
!/assets/posts/authors.yml
# 课程同理：真实（付费）课程放私有内容仓库（CONTENT_DIR），这里只留示例课
/assets/courses/*
!/assets/courses/rust-basics/
/assets/docs/*
!/assets/docs/index.md
!/assets/docs/axum/
!/assets/docs/burn/
!/assets/docs/dioxus/
!/assets/docs/weekly/

# 规划文件只放本地（框架仓库公开）
Todos.md
TODOs.md
docs/archive/todos/
