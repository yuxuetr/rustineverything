# Generated by Cargo
# will have compiled files and executables
/target
.DS_Store

# These are backup files generated by rustfmt
**/*.rs.bk
node_modules/
assets/data/
assets/uploads/
public/uploads/
public/data/
.env

# crates/app/assets/ is a build-time mirror of root assets/ (populated by build.rs)
# Only root assets/ is the source of truth — do not track the copy.
crates/app/assets/

# tailwind.css is compiled output (not hand-edited); tracked in root assets/ only
# Source: crates/app/tailwind-input.css → compile → crates/app/assets/tailwind.css → sync → assets/tailwind.css
