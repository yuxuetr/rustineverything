# Phase 7.4.2：docker-compose / 本地开发的环境变量模板。
#
# 使用：
#   cp .env.example .env
#   # 编辑 .env，把所有占位值替换为你自己的凭据
#
# `.env` 已在 .gitignore 中，不会被提交。
# `docker compose up` 默认读取 `.env`，`cargo run` 通过 `dotenvy` 同样读取。

# ─── 必填：启动时校验，缺失会 panic ────────────────────────────
# 32+ 字符随机串；生产环境用 `openssl rand -hex 32` 生成。
JWT_SECRET=change-me-to-a-32-char-random-string

# 站点对外可访问 URL（含 scheme，无尾斜杠）。OAuth callback / sitemap /
# feed canonical 都基于此拼接；线上 https → cookie 自动追加 Secure。
BASE_URL=http://127.0.0.1:8080


# ─── docker compose 数据库 / app 端口 ─────────────────────────
POSTGRES_USER=rie
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=rie
APP_PORT=8080


# ─── 本地非容器开发场景下的 DATABASE_URL ─────────────────────
# docker compose 模式下 app 容器内会自动拼接 DATABASE_URL 指向 postgres
# 服务名；此处仅供本机 cargo run / cargo test 使用。
DATABASE_URL=postgres://rie:change-me-to-a-strong-password@127.0.0.1:5432/rie


# ─── OAuth 提供方凭据（可选；未配置的 provider 自动从登录页隐藏）──
# 申请方式见 docs/AUTH_GUIDE.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=


# ─── 日志 ───────────────────────────────────────────────────
# 见 tracing-subscriber EnvFilter 文档：
# 例：RUST_LOG=info,rustineverything_core=debug,sqlx=warn
RUST_LOG=info
