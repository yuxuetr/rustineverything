# Phase 7.4.2：docker-compose / 本地开发的环境变量模板。
#
# 使用：
#   cp .env.example .env
#   # 编辑 .env，把所有占位值替换为你自己的凭据
#
# `.env` 已在 .gitignore 中，不会被提交。
# `docker compose up` 默认读取 `.env`，`cargo run` 通过 `dotenvy` 同样读取。

# ─── 必填：启动时校验，缺失会 panic ────────────────────────────
# 32+ 字符随机串；生产环境用 `openssl rand -hex 32` 生成。
JWT_SECRET=change-me-to-a-32-char-random-string

# 站点对外可访问 URL（含 scheme，无尾斜杠）。OAuth callback / sitemap /
# feed canonical 都基于此拼接；线上 https → cookie 自动追加 Secure。
BASE_URL=http://127.0.0.1:8080

# ─── 推荐：独立数据加密密钥（S5）────────────────────────
# 用于 AES-256-GCM 加密敏感数据（PKCE cookie 等），与 JWT_SECRET 解耦，
# 可单独轮换。未配置时回退到 JWT_SECRET 派生（启动日志会 warn）。
# 生成：`openssl rand -hex 32`
# DATA_ENCRYPTION_KEY=

# ─── 运维开关（S1/S2/S3，均可选）──────────────────────
# 生产推荐 1：schema 迁移失败直接拒绝启动（docker compose 默认已开）。
# 本地开发缺省关闭；降级状态可通过 GET /healthz 观测（ok/degraded）。
# STRICT_MIGRATION=1
#
# 应用层限流（仅 /api/*；auth/pay 走 SENSITIVE 桶）。缺省：
# API 20 rps / burst 60；SENSITIVE 5 rps / burst 15。超限返回 429。
# RATE_LIMIT_API_RPS=20
# RATE_LIMIT_API_BURST=60
# RATE_LIMIT_SENSITIVE_RPS=5
# RATE_LIMIT_SENSITIVE_BURST=15
# RATE_LIMIT_DISABLED=1        # 排障用，生产勿开
#
# 安全响应头：CSP_POLICY 覆盖默认策略（置空字符串 = 不发 CSP 头）。
# CSP_POLICY=
# SECURITY_HEADERS_DISABLED=1  # 排障用，生产勿开


# ─── 支付（M5，可选；网关凭据清单见 docs/PAYMENT_SPEC.md §8）────
# 对账定时任务（M5e）：周期扫描滞留 pending 订单，向网关查单回填发货
# （回调丢失兜底）/ 超过支付窗口关单。网关未配置时每轮空跑，无需关闭。
# PAY_RECONCILE_INTERVAL_SECS=300     # 扫描间隔（下限 60）
# PAY_RECONCILE_MIN_AGE_SECS=300      # 下单后至少等这么久才查单
# PAY_RECONCILE_CLOSE_AFTER_SECS=7200 # 超过此时长仍未支付 → 关单
# PAY_RECONCILE_DISABLED=1            # 排障用，平时无需开
#
# 网关凭据：每个网关的变量要么全设、要么全不设。启动日志会逐个网关报告
# 已启用 / 未配置 / 缺哪些变量 / 值格式不对。密钥填 PEM（多行时用双引号包住）或去掉头尾行的
# base64 单行均可。三个网关共用 PAY_NOTIFY_BASE（公网 https 根地址，拼回调与返回地址）。
# PAY_NOTIFY_BASE=https://your-domain
#
# 支付宝（PAYMENT_SPEC §4）。回调：{PAY_NOTIFY_BASE}/api/pay/alipay/notify
# ALIPAY_APP_ID=
# ALIPAY_APP_PRIVATE_KEY=        # 应用私钥（RSA2）
# ALIPAY_PUBLIC_KEY=             # 支付宝公钥（不是应用公钥）
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do  # 默认值；沙箱改成沙箱网关
#
# 微信支付 v3（PAYMENT_SPEC §5，公钥模式）。回调：{PAY_NOTIFY_BASE}/api/pay/wechat/notify
# WECHAT_MCHID=
# WECHAT_APP_ID=                 # 商户号绑定的 appid
# WECHAT_API_V3_KEY=             # APIv3 密钥，必须正好 32 字节
# WECHAT_MCH_PRIVATE_KEY=        # 商户 API 证书私钥（apiclient_key.pem）
# WECHAT_MCH_SERIAL_NO=          # 商户 API 证书序列号
# WECHAT_PLATFORM_PUBLIC_KEY=    # 微信支付公钥（商户平台「API 安全」下载），验回调签名
#
# Stripe（PAYMENT_SPEC §15）：信用卡与海外支付方式。
# Webhook：{PAY_NOTIFY_BASE}/api/pay/stripe/notify，订阅 checkout.session.completed
# 与 checkout.session.async_payment_succeeded。本地可用 `stripe listen --forward-to
# localhost:8080/api/pay/stripe/notify` 拿到 whsec_。
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...


# ─── docker compose 数据库 / app 端口 ─────────────────────────
POSTGRES_USER=rie
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=rie
APP_PORT=8080


# ─── 本地非容器开发场景下的 DATABASE_URL ─────────────────────
# docker compose 模式下 app 容器内会自动拼接 DATABASE_URL 指向 postgres
# 服务名；此处仅供本机 cargo run / cargo test 使用。
DATABASE_URL=postgres://rie:change-me-to-a-strong-password@127.0.0.1:5432/rie


# ─── OAuth 提供方凭据（可选；未配置的 provider 自动从登录页隐藏）──
# 申请方式见 docs/AUTH_GUIDE.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=


# ─── 日志 ───────────────────────────────────────────────────
# 见 tracing-subscriber EnvFilter 文档：
# 例：RUST_LOG=info,rustineverything_core=debug,sqlx=warn
RUST_LOG=info


# ─── LLM (Phase 4 审核 / 自由问答) ───────────────────────────
# 两套独立配置，按需开启任意一种或两种：
#  - 主流厂商（OpenAI / DeepSeek / Moonshot / Qwen / Together / Groq / Ollama）
#    几乎都支持 OpenAI 兼容协议；优先填这一组。
#  - Anthropic / Claude / DeepSeek `/anthropic` 路径走 Anthropic 协议。
#
# 选择规则：OPENAI_* 一对都非空 → 用 OpenAI；否则 ANTHROPIC_* 一对都非
# 空 → 用 Anthropic；都未配置 → LLM 功能优雅降级（审核 fail-open）。
# 调用时不做运行时 failover（避免吞掉真实错误）。
#
# DeepSeek 同时支持两种协议，两套 key 可填同一值。
OPENAI_LLM_BASE_URL=https://api.deepseek.com
OPENAI_LLM_API_KEY=
# 可选：覆盖模型（默认 deepseek-chat）
# OPENAI_LLM_MODEL=deepseek-chat

ANTHROPIC_LLM_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_LLM_API_KEY=
# 可选：覆盖模型（默认 deepseek-chat）
# ANTHROPIC_LLM_MODEL=deepseek-chat
