{
  "site_name": "Rust in Everything",
  "site_description": "专注 Rust 技术栈的学习与实战",
  "theme": "ocean",
  "active_layout": "classic",
  "default_language": "zh",
  "author": "yuxuetr",
  "paths": {
    "plugins": "assets/plugins"
  },
  "navigation": [
    { "key": "nav-blog", "route": "/blog" },
    { "key": "nav-podcast", "route": "/podcast" },
    { "key": "nav-forum", "route": "/topics" }
  ],
  "auth": {
    "enabled": true,
    "providers": ["github", "google", "discord", "twitter"]
  },
  "annotations": {
    "course": true,
    "doc": true,
    "blog": true
  }
}
